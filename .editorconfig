# How the files of the project are written: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ruff, with its default line length
[*.py]
indent_size = 4
max_line_length = 88

# Written by Jupyter
[*.ipynb]
indent_size = 1

# Unmodified excerpts of real DPC files: never edited, not even their last line
[tests/fixtures/real/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
